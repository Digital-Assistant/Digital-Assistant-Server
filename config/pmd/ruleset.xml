<?xml version="1.0"?>
<ruleset name="UDAN Server bug-oriented rules"
		xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
	<description>Small bug-oriented ruleset. Style is the formatter's job, not PMD's.</description>

	<rule ref="category/java/errorprone.xml">
		<exclude name="AvoidLiteralsInIfCondition"/>
		<exclude name="MissingSerialVersionUID"/>
		<exclude name="BeanMembersShouldSerialize"/>
		<exclude name="DataflowAnomalyAnalysis"/>
		<exclude name="NullAssignment"/>
		<exclude name="AvoidFieldNameMatchingMethodName"/>
		<exclude name="AvoidDuplicateLiterals"/>
	</rule>

	<!-- Baseline: files that violate the rules above on the untouched tree are excluded here (debt). Shrink only. -->
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/config/HealthCheckListener.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/config/XssSanitizationFilter.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/converters/UserclicknodeConverter.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/models/AdditionalParamsBinder.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/models/SequenceVotes.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/search/StartupReindexer.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/Clickevents.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchList.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchListWithLinks.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchTerms.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchWithID.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchWithIDWithPermissions.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SearchWithPermissions.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/services/SequenceListService.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/User.java</exclude-pattern>
	<exclude-pattern>.*/src/main/java/com/nistapp/uda/index/users/OwnerView.java</exclude-pattern>
	<exclude-pattern>.*/src/test/java/com/nistapp/uda/index/search/PrefixIndexLayoutStrategyTest.java</exclude-pattern>
	<exclude-pattern>.*/src/test/java/com/nistapp/uda/index/utils/InputSanitizerTest.java</exclude-pattern>
</ruleset>
