# Variables read by the CI scripts, the workflows and the container. Names only, no values.
# This is a documentation file: nothing loads it. Do not put a real value here; set the real ones as
# GitHub repository variables / secrets (CI) or in your shell (local runs).
# Meaning of each CI script: scripts/ci/README.md. Application settings: README.md, "Configuration".
#
# Legend: "required" = the script stops without it; "optional" = a default applies (shown as "default ...").
# Placeholders look like <this>.
#
# Not inventory (the audit engine may list them as missing; they are not inputs):
#   SECONDS, HOME   bash builtin / login environment, not set by the owner
#   BASE, HEAD, VERSION, SHA256, ACTIONLINT_VERSION, ACTIONLINT_SHA256, ZIZMOR_VERSION, POLL_SECONDS
#                   constants or positional arguments assigned inside the scripts before use
#   ACTIONS_ID_TOKEN_REQUEST_URL, ACTIONS_ID_TOKEN_REQUEST_TOKEN, GITHUB_RUN_ID, GITHUB_ACTOR,
#   GITHUB_STEP_SUMMARY, GITHUB_TOKEN
#                   provided by the GitHub Actions runner
#   AWS_SESSION_TOKEN, AWS_SECRET_ACCESS_KEY, AWS_ACCESS_KEY_ID
#                   set by deploy-test.sh / deploy-prod.sh from their own OIDC login result
#   The engine's list is not the inventory; this file is.

# --- GitHub repository variables (Settings > Secrets and variables > Actions > Variables) ---

# deploy-test.sh, deploy-prod.sh: AWS region of the deploy box. optional, default ap-south-1
AWS_REGION=
# deploy-test.sh: IAM role the TEST deploy job assumes through OIDC. required for TEST deploys
AWS_ROLE_ARN=<aws-role-arn>
# deploy-test.sh, deploy-prod.sh: EC2 instance that receives the SSM command. required (TEST and PROD share it)
INSTANCE_ID=<i-instance-id>
# deploy-test.sh: SSM document that performs the TEST deploy. required for TEST deploys
SSM_DOCUMENT=<ssm-document-name>
# deploy-test.yml, image.yml: base URL for the post-deploy smoke test. optional
TEST_BASE_URL=<https://test-host>
# image.yml: "true" deploys to TEST after every push to dev. optional
TEST_AUTO_DEPLOY=
# deploy-prod.yml: IAM role for the PROD deploy (passed to deploy-prod.sh as AWS_ROLE_ARN). required for PROD deploys
PROD_AWS_ROLE_ARN=<aws-role-arn>
# deploy-prod.yml: SSM document for the PROD deploy (passed to deploy-prod.sh as SSM_DOCUMENT). required for PROD deploys
PROD_SSM_DOCUMENT=<ssm-document-name>
# deploy-prod.yml: base URL for the post-deploy smoke test. optional (the test is skipped when empty)
PROD_BASE_URL=<https://prod-host>
# release.yml: id of the GitHub App that cuts releases. required for releases
RELEASE_APP_ID=

# --- GitHub secrets (Settings > Secrets and variables > Actions > Secrets) ---

# release.yml: private key of the release GitHub App. required for releases. Never commit it
RELEASE_APP_PRIVATE_KEY=

# --- Script inputs (environment of a local run or a workflow step) ---

# deploy-test.sh, deploy-prod.sh: minutes to wait for the SSM command. optional, default 20 (TEST) / 45 (PROD)
DEPLOY_TIMEOUT_MIN=
# image.sh: image name. optional, default udan-server
IMAGE_NAME=
# image.sh: image tag. optional, default local
IMAGE_TAG=
# image.sh: write the image to this tar file instead of the local Docker store (CI mode). optional
IMAGE_TAR=
# image.sh: directory that reuses build layers between runs. optional
CACHE_DIR=
# image-scan.sh: Trivy cache directory. optional, default $HOME/.cache/trivy
TRIVY_CACHE_DIR=
# latest-image-digest.sh: owner/repo whose Image run is read. required
GITHUB_REPOSITORY=<owner/repo>
# latest-image-digest.sh: workflow file that builds the image. optional, default image.yml
IMAGE_WORKFLOW=
# latest-image-digest.sh: branch whose newest image is wanted. optional, default dev
IMAGE_BRANCH=
# latest-image-digest.sh: name prefix of the job that pushes the image. optional, default "Build and Push"
IMAGE_JOB=
# latest-image-digest.sh: seconds to wait for that job. optional, default 600
IMAGE_WAIT_SECONDS=
# smoke-test.sh: number of attempts. optional, default 3
SMOKE_ATTEMPTS=
# smoke-test.sh: seconds between attempts. optional, default 5
SMOKE_WAIT=
# test.sh: Flyway baseline on migrate for the test database. optional, default true
QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=
# test.sh: Flyway baseline version for the test database. optional, default 0
QUARKUS_FLYWAY_BASELINE_VERSION=

# --- CI only (ci.yml sets these for its throwaway test database; never use for a real one) ---

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# --- Application and container (all optional; the packaged application.properties applies) ---

# Datasource settings the README "Container" paragraph tells container users to pass.
QUARKUS_DATASOURCE_JDBC_URL=
QUARKUS_DATASOURCE_USERNAME=
QUARKUS_DATASOURCE_PASSWORD=
# Dockerfile.jvm: properties file the app reads (default /deployments/config/additional.properties)
QUARKUS_CONFIG_LOCATIONS=
# Dockerfile.jvm: JVM options (the image sets a default)
JAVA_OPTS=
# Application keys, overridable as environment variables; meanings and defaults: README.md, "Configuration".
UDAN_AUTH_LEGACY_ANONYMOUS_LOGIN=
UDAN_AUTH_LEGACY_CLIENT_IDS=
UDAN_AUTH_PKCE_CLIENT_IDS=
UDAN_REALM_REQUIRED=
UDAN_SEARCH_INDEX_PREFIX=
UDAN_SEARCH_REINDEX_ATTEMPTS=
UDAN_SEARCH_REINDEX_BATCH_SIZE=
UDAN_SEARCH_REINDEX_THREADS=
UDAN_SEARCH_REINDEX_ON_STARTUP=
