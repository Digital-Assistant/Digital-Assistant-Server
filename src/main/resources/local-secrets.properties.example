# Template. Copy to local-secrets.properties (untracked) or run ./sync-credentials.sh,
# which creates the file and fills it from the udan-workspace infra (infra/.env and the realm file).
# Never commit local-secrets.properties.
# In a value, write "\" as "\\" and "$" as "\\$" (java.util.Properties, then SmallRye Config).
quarkus.datasource.password=
quarkus.oidc.credentials.secret=
# Postgres superuser for pre-flight-check.sh only (POSTGRES_USER / POSTGRES_PASSWORD in infra/.env).
preflight.postgres.username=
preflight.postgres.password=
