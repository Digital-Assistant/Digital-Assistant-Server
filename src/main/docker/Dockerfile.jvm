####
# This Dockerfile is used to build a container that runs the Quarkus application in JVM mode.
# It uses a multi-stage build, meaning you do not need to install Gradle or Java on the host.
#
# Build the image with:
#
# docker build -f src/main/docker/Dockerfile.jvm -t udan-backend .
#
# Run the container with:
#
# docker run -i --rm -p 11081:11081 udan-backend
#
###

# Stage 1: Build the application using Gradle
FROM gradle:7.3.1-jdk11 AS build
COPY --chown=gradle:gradle . /home/gradle/src
WORKDIR /home/gradle/src
RUN gradle build -x test --no-daemon

# Stage 2: Create the runtime JRE image
FROM eclipse-temurin:11-jre
ENV LANGUAGE='en_US:en'

WORKDIR /deployments

# Copy the Quarkus fast-jar artifacts from the build stage
COPY --from=build /home/gradle/src/build/quarkus-app/lib/ /deployments/lib/
COPY --from=build /home/gradle/src/build/quarkus-app/quarkus/ /deployments/quarkus/
COPY --from=build /home/gradle/src/build/quarkus-app/app/ /deployments/app/
COPY --from=build /home/gradle/src/build/quarkus-app/quarkus-run.jar /deployments/
COPY --from=build /home/gradle/src/build/quarkus-app/quarkus-app-dependencies.txt /deployments/

EXPOSE 11081

# Configure environment options
ENV JAVA_OPTS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar quarkus-run.jar"]